# ACD Mentor — Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your API keys.
# NEVER commit your .env file to git — it is in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Provider (choose one or more) ────────────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Active provider: "groq" | "openai" ────────────────────────────────────────
LLM_PROVIDER=groq

# ── Model names ───────────────────────────────────────────────────────────────
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o-mini
# Fallback model (used automatically when primary hits rate limits):
# Groq: llama-3.1-8b-instant | OpenAI: gpt-4o-mini (cross-provider)

# ── Embeddings ────────────────────────────────────────────────────────────────
# "local" uses sentence-transformers (free, runs locally)
# "openai" uses text-embedding-3-small (requires OPENAI_API_KEY)
EMBEDDING_PROVIDER=local

# ── Vector store ─────────────────────────────────────────────────────────────
VECTOR_STORE=chroma            # chroma | faiss
CHROMA_PERSIST_DIR=./data/chroma_db

# ── External knowledge ───────────────────────────────────────────────────────
ENABLE_WEB_KNOWLEDGE=true      # fetch GeeksforGeeks + other sources
