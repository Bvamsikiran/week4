# ACD Mentor — Configuration  (v2)
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your API keys.
# NEVER commit your .env file to git — it is in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Provider (choose one or more) ────────────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Active provider: "groq" | "openai" ───────────────────────────────────────
LLM_PROVIDER=groq

# ── Model names (free-tier preferred) ────────────────────────────────────────
GROQ_MODEL=llama-3.1-8b-instant
OPENAI_MODEL=gpt-4o-mini
# Groq fallback: llama-3.1-8b-instant (free tier)
# OpenAI fallback: gpt-4o-mini (cheapest)

# ── Embeddings ────────────────────────────────────────────────────────────────
# "local" uses sentence-transformers (free, runs locally)
# "openai" uses text-embedding-3-small (requires OPENAI_API_KEY)
EMBEDDING_PROVIDER=local

# ── Vector store ──────────────────────────────────────────────────────────────
VECTOR_STORE=chroma            # chroma | faiss
CHROMA_PERSIST_DIR=./data/chroma_db

# ── External knowledge ────────────────────────────────────────────────────────
ENABLE_WEB_KNOWLEDGE=true      # fetch GeeksforGeeks + other sources

# ── Mem0 Memory Agent ─────────────────────────────────────────────────────────
# Get your key at: https://app.mem0.ai/
# Leave blank to disable cross-session memory (local session memory still works)
MEM0_API_KEY=m0-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Voiceflow Voice Agent ─────────────────────────────────────────────────────
# Get from: https://creator.voiceflow.com → Integrations → API Key
# Leave blank to disable voice mode (text-only fallback)
VOICEFLOW_API_KEY=VF.DM.xxxxxxxxxxxxxxxxxxxxxxxx
VOICEFLOW_PROJECT_ID=xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: pin a specific published version (default: "production")
VOICEFLOW_VERSION_ID=production
