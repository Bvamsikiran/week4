# Streamlit secrets file (for Streamlit Cloud deployment)
# ─────────────────────────────────────────────────────────────────────────────
# DO NOT commit this file to git!  It is listed in .gitignore.
# For local dev, use a .env file instead.
#
# For Streamlit Cloud:
#   1. Push your repo to GitHub.
#   2. Go to your app's Settings → Secrets.
#   3. Paste the contents of this file (with real values).
# ─────────────────────────────────────────────────────────────────────────────

GROQ_API_KEY = "gsk_xxxxxx"
OPENAI_API_KEY = "sk-xxxxxx"
LLM_PROVIDER = "groq"
GROQ_MODEL = "llama-3.3-70b-versatile"
OPENAI_MODEL = "gpt-4o-mini"
EMBEDDING_PROVIDER = "local"
VECTOR_STORE = "chroma"
CHROMA_PERSIST_DIR = "./data/chroma_db"
ENABLE_WEB_KNOWLEDGE = "true"
